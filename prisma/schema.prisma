datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TripStatus {
  PLANNED
  ON_ROAD
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

model AppUser {
  id          String   @id @db.Uuid
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

model VehicleOwner {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buses Bus[]
  trips Trip[]

  @@index([isActive])
  @@index([name])
}

model Bus {
  id        String   @id @default(cuid())
  plate     String   @unique
  capacity  Int
  ownerId   String
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  trips Trip[]

  @@index([ownerId])
  @@index([isActive])
}

model Convoy {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips Trip[]

  @@index([isActive])
}

model Trip {
  id                String     @id @default(cuid())
  convoyId          String?
  busId             String
  ownerId           String
  plateSnapshot     String
  capacitySnapshot  Int
  ownerNameSnapshot String
  departureLocation String
  arrivalLocation   String
  startsAt          DateTime
  endsAt            DateTime
  status            TripStatus @default(PLANNED)
  agreedAmount      Decimal    @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  convoy   Convoy?      @relation(fields: [convoyId], references: [id], onDelete: SetNull)
  bus      Bus          @relation(fields: [busId], references: [id], onDelete: Restrict)
  owner    VehicleOwner @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([busId])
  @@index([ownerId])
  @@index([convoyId])
  @@index([startsAt])
  @@index([status])
}

model Payment {
  id        String        @id @default(cuid())
  tripId    String
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime
  method    PaymentMethod
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([paidAt])
}
