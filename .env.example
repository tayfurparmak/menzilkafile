# ==============================================================================
# KAFİLE YÖNETİM SİSTEMİ - ORTAM DEĞİŞKENLERİ (.env.example)
# ==============================================================================
# Bu dosya örnek şablondur. Gerçek gizli anahtarları bu dosyaya yazmayın.
# Yerel geliştirme için bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# Git deposuna asla .env dosyasını dahil etmeyin (.gitignore korumalıdır).

# ==============================================================================
# A. SERVER-ONLY (GİZLİ / ÖZEL - İSTEMCİYE ASLA SIZDIRILMAZ)
# Vercel üzerinde Environment Variables eklenirken kullanılır.
# ==============================================================================

# 1. DATABASE_URL:
# Supabase Transaction Pooler URL (Port: 6543, pgbouncer=true).
# Vercel Serverless ve Nuxt API runtime sorgularında PostgreSQL bağlantı tükenmesini önler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL:
# Supabase Doğrudan Bağlantı / Session URL (Port: 5432).
# 'prisma migrate deploy' şema yönetiminde DDL kilitleri için gereklidir.
# IPv4 desteği için pooler üzerindeki 5432 portu (session mode) önerilir.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. SUPABASE_SERVICE_ROLE_KEY:
# Supabase admin yetkisine sahip gizli anahtar. Sadece sunucu tarafında doğrulamalar için kullanılır.
# Nuxt public runtime config içine KESİNLİKLE EKLENMEZ.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_secret"

# ==============================================================================
# B. PUBLIC (İSTEMCİ TARAFINDA ERİŞİLEBİLİR GENEL DEĞİŞKENLER)
# Nuxt `public` runtime config üzerinden tarayıcıya güvenle aktarılabilir.
# ==============================================================================

# 4. SUPABASE_URL:
# Supabase API URL'i (Project Settings -> API sekmesinden alınır).
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# 5. SUPABASE_ANON_KEY:
# Supabase Anon Public Key (Project Settings -> API sekmesinden alınır).
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key"

# ==============================================================================
# C. UYGULAMA VE ZAMAN DİLİMİ AYARLARI
# ==============================================================================
TZ="Europe/Istanbul"
NODE_ENV="production"
